# ============================================================
# NutriHealth Backend — Environment Variables Template
# ============================================================

# ─── AWS Bedrock auth (AI analysis) ─────────────────────────
# Either provide BEDROCK_API_KEY (pre-signed-URL style key:
#   bedrock-api-key-<base64-encoded https URL>)
# …AND/OR standard AWS IAM credentials (access key + secret):
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
# Optional: session token (only for temporary/STS credentials)
AWS_SESSION_TOKEN=
# Region hosting the model (defaults to us-east-2 when unset)
# AWS_REGION is also respected; BEDROCK_REGION wins if both set
BEDROCK_REGION=us-east-2

# ─── Gemini (AI assistant chat) ────────────────────────────
# Used by POST /api/chat. Get a key from https://aistudio.google.com/apikey
# (current key prefix: AQ. )
GEMINI_API_KEY=your_gemini_api_key

# ─── OpenRouter (fallback AI provider) ─────────────────────
# Used by POST /api/chat only if GEMINI_API_KEY is unset.
# Get a key from https://openrouter.ai/keys (prefix: sk-or-v1-)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# ─── Dev auth fallback ──────────────────────────────────────
# When the backend CANNOT reach AWS Cognito (locked-down network / offline
# demo / sandbox that blocks egress to cognito-idp), strict token verification
# fails because the JWKS signing keys can't be fetched. Set this to true to
# fall back to LOCAL JWT decoding (no signature check) so the app still works.
# Leave false (default) in production — strict verification is then required.
DEV_AUTH_ENABLED=false

# ─── Neon Postgres database ───────────────────────────────
# Standard libpq-style connection params (node-postgres reads these natively).
# Copy these from your Neon dashboard. When present, the API persists all user
# data (profile, preferences, goals, medical info, reports) to Neon. When
# absent, it falls back to a local JSON file store (server/data/store.json).
PGHOST=ep-xxxxxx-pooler.c-11.us-east-1.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=your_neon_password
PGSSLMODE=require
PGCHANNELBINDING=require
PGPORT=5432

# Port the Express server listens on
PORT=5000

# Node environment
NODE_ENV=development